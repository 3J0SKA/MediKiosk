# Copy this file to .env and fill in your local MySQL credentials

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=medikiosk

UPLOAD_FOLDER=uploads

# Path to tesseract executable
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Mac (brew):       /opt/homebrew/bin/tesseract
# Linux:             /usr/bin/tesseract
TESSERACT_CMD=/usr/bin/tesseract

SECRET_KEY=change-this-to-something-random
FLASK_DEBUG=1

# Hugging Face Access Token (Required for Indic Parler-TTS)
# Accept terms at https://huggingface.co/ai4bharat/indic-parler-tts and get token from https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here
JWT_SECRET=change-this-to-something-random

HUATUO_API_KEY=your_api_key_here
